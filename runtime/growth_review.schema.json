{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ButlerX item-level growth proposal review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "target", "proposal_hash", "aggregate_status", "created_at", "items"],
  "properties": {
    "schema_version": {"const": 2},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "target": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregate_status": {"enum": ["pending", "partially_reviewed", "reviewed"]},
    "created_at": {"type": "string"},
    "items": {
      "type": "object",
      "propertyNames": {"pattern": "^p-[0-9a-f]{16}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_hash", "status", "reviewed_at", "reviewed_by", "reason"],
        "properties": {
          "item_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["pending", "approved", "rejected"]},
          "reviewed_at": {"type": ["string", "null"]},
          "reviewed_by": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"], "maxLength": 2000}
        }
      }
    }
  }
}
