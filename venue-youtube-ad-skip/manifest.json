{
  "manifest_version": 3,
  "name": "Venue YouTube Ad Controller",
  "version": "1.1.0",
  "description": "Controls YouTube ad playback for the Venue kiosk without pressing skip buttons.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" }
}
